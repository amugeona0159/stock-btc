# 빌드 컨텍스트에서 뺄 것.
#
# `flyctl deploy --remote-only` 는 **컨텍스트를 통째로 올린다.** 이게 없으면
# `.venv`(수백 MB)·`node_modules`·`store_data`(모델 .pkl)·판 기록까지 다 올라간다.
# 이미지에 안 들어가더라도 매 배포가 그만큼 느려진다.

.git/
.venv/
venv/
node_modules/
web/node_modules/
web/dist/
__pycache__/
*.py[cod]
.pytest_cache/
.cache/

# 모델은 이미지에 안 넣는다. 무겁고, 설정만 있으면 다시 굽는다.
store_data/
logs/
screenshots/

# 이 PC 사람의 개인 기록. 걸어 둔 알림·보유 종목이 그대로 들어 있다.
alerts/
# 내 PC 가 쓰는 학습 기록. 배포판이 읽는 것은 저장소의 `learning/` 이다.
learning-local/
# 판 하나하나의 원자료. 수만 줄이고 화면은 요약(state.json)만 읽는다.
learning/study/verdicts.jsonl

.env
