# 암호화폐(Binance/Upbit)는 키가 필요 없다. 아래는 없으면 해당 프로바이더만 비활성된다.

# 미국주식 실시간 틱 — https://finnhub.io 무료 가입
FINNHUB_API_KEY=

# 국내·미국 주식 — 토스증권 WTS 설정 > Open API 에서 발급 (토스증권 계좌 필요).
# 호출할 IP 를 허용 목록에 등록해야 한다. 한 키로 KRX 와 미국주식을 모두 본다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# 국내주식 — https://apiportal.koreainvestment.com (증권계좌 필요)
KIS_APP_KEY=
KIS_APP_SECRET=
# 실전=prod, 모의투자=paper
KIS_ENV=prod

# 질문을 자연어로 받으려면 필요하다. 없으면 규칙 파서로 내려가고,
# "일주일 뒤", "급락 나온 뒤 3일" 같은 흔한 표현은 그대로 알아듣는다.
ANTHROPIC_API_KEY=

# 위키백과 조회수(관심도 축)를 받을 때 쓰는 연락처. Wikimedia 는 연락처 없는
# User-Agent 를 403 으로 막는다. 자기 저장소 주소나 메일로 바꿔 둘 것.
MARKET_LENS_CONTACT=
